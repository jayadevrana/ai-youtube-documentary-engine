# Core
PROJECT_NAME=xmoney_mindset
ENABLE_REAL_GENERATION=false
DEFAULT_CATEGORY=finance / psychology / success

# Duration and render controls
TARGET_DURATION_MINUTES=5
SCENE_DURATION_SECONDS=6
FPS=30
WIDTH=1920
HEIGHT=1080

# Optional API keys
OPENAI_API_KEY=
XAI_API_KEY=

# Optional OpenAI models
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Local fallback TTS voice for macOS `say`
LOCAL_TTS_VOICE=Daniel

# Optional background music file
BACKGROUND_MUSIC_PATH=
